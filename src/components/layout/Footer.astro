---
import settings from '../../content/settings/general.json';

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Our Projects' },
  { href: '/people', label: 'Our People' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const services = [
  'Boundary Surveys',
  'Topographic Surveys',
  'Architectural Design',
  '3D Renderings',
  'Integrated Packages',
];
---

<footer class="relative bg-black-soft border-t border-white/5">
  <!-- Decorative gold line at top -->
  <div class="h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 border border-gold flex items-center justify-center">
            <span class="font-display text-gold text-xl font-bold">R</span>
          </div>
          <div>
            <span class="font-display text-warm-white text-lg tracking-wide">Regal</span>
            <span class="block text-[10px] tracking-[0.25em] uppercase text-gold-dim font-body">Engineering & Design</span>
          </div>
        </div>
        <p class="text-grey text-sm leading-relaxed mt-4 font-body">
          Integrated land surveying and architectural design services. Precision in every measurement, creativity in every design.
        </p>
        <p class="text-gold-dim text-xs tracking-[0.2em] uppercase mt-4 font-body italic">
          Precision. Design. Vision.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display text-gold text-sm tracking-[0.2em] uppercase mb-6">Navigate</h4>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-warm-white/60 hover:text-gold text-sm font-body transition-colors duration-300 inline-flex items-center gap-2 group"
              >
                <span class="w-0 group-hover:w-4 h-px bg-gold transition-all duration-300"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-display text-gold text-sm tracking-[0.2em] uppercase mb-6">Services</h4>
        <ul class="space-y-3">
          {services.map(service => (
            <li>
              <span class="text-warm-white/60 text-sm font-body">{service}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="font-display text-gold text-sm tracking-[0.2em] uppercase mb-6">Contact</h4>
        <ul class="space-y-4 text-sm font-body">
          <li class="flex items-start gap-3 text-warm-white/60">
            <svg class="w-4 h-4 text-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
            </svg>
            <span set:html={settings.address.replace(/,\s*/g, ',<br />')} />
          </li>
          <li>
            <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="flex items-center gap-3 text-warm-white/60 hover:text-gold transition-colors">
              <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              {settings.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${settings.email}`} class="flex items-center gap-3 text-warm-white/60 hover:text-gold transition-colors">
              <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              {settings.email}
            </a>
          </li>
        </ul>

        <!-- Social Links -->
        <div class="flex items-center gap-4 mt-6">
          {settings.linkedin && (
            <a href={settings.linkedin} aria-label="LinkedIn" class="w-9 h-9 border border-white/10 flex items-center justify-center hover:border-gold hover:bg-gold/10 transition-all duration-300">
              <svg class="w-4 h-4 text-warm-white/60" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {settings.facebook && (
            <a href={settings.facebook} aria-label="Facebook" class="w-9 h-9 border border-white/10 flex items-center justify-center hover:border-gold hover:bg-gold/10 transition-all duration-300">
              <svg class="w-4 h-4 text-warm-white/60" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {settings.instagram && (
            <a href={settings.instagram} aria-label="Instagram" class="w-9 h-9 border border-white/10 flex items-center justify-center hover:border-gold hover:bg-gold/10 transition-all duration-300">
              <svg class="w-4 h-4 text-warm-white/60" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-grey text-xs font-body text-center md:text-left">
        &copy; {new Date().getFullYear()} Regal Engineering & Design Solutions. A subsidiary of Regal Affluent Holding LLC.
      </p>
      <p class="text-grey/50 text-xs font-body">
        Freetown, Sierra Leone
      </p>
    </div>
  </div>
</footer>
