---
interface Props {
  title: string;
  category: string;
  location: string;
  shortDescription: string;
  image: string;
  slug: string;
}

const { title, category, location, shortDescription, image, slug } = Astro.props;

const categoryLabels: Record<string, string> = {
  'land-surveying': 'Land Surveying',
  'architectural-design': 'Architectural Design',
  'integrated': 'Integrated',
};
---

<a
  href={`/projects/${slug}`}
  class="group relative bg-black-soft border border-white/5 overflow-hidden transition-all duration-500 hover:border-gold/40 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(201,168,76,0.08)] block"
>
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
    <!-- Category tag -->
    <span class="absolute top-4 left-4 px-3 py-1 text-[10px] tracking-[0.2em] uppercase font-body border border-gold/50 text-gold bg-black/60 backdrop-blur-sm">
      {categoryLabels[category] || category}
    </span>
  </div>

  <!-- Content -->
  <div class="p-6">
    <h3 class="font-display text-xl text-warm-white mb-1 group-hover:text-gold transition-colors duration-300">{title}</h3>
    <p class="text-grey text-xs font-body mb-3">{location}</p>
    <p class="text-warm-white/60 text-sm font-body leading-relaxed line-clamp-2">{shortDescription}</p>
    <span class="inline-flex items-center gap-2 mt-4 text-gold text-xs tracking-[0.15em] uppercase font-body">
      View Details
      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
      </svg>
    </span>
  </div>
</a>
