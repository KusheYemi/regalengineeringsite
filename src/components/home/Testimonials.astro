---
import SectionLabel from '../ui/SectionLabel.astro';

const testimonials = [
  {
    quote: 'Regal Engineering delivered our boundary survey ahead of schedule and with exceptional accuracy. Their drone technology gave us insights we didn\'t even know we needed. Highly recommended for any serious development project.',
    name: 'Amara Conteh',
    role: 'Property Developer, Freetown',
  },
  {
    quote: 'The integrated survey-to-design package saved us weeks of coordination. One team, one vision, one flawless result. Our residential project went from concept to permit in record time.',
    name: 'Ibrahim Kamara',
    role: 'Director, Kamara Holdings Ltd',
  },
  {
    quote: 'Their architectural renderings were stunning — they captured exactly what we envisioned. The attention to detail in both the survey data and the design work was truly impressive.',
    name: 'Fatmata Sesay',
    role: 'Homeowner, Hill Station',
  },
];
---

<section class="relative py-24 lg:py-32 bg-black-soft overflow-hidden">
  <!-- Decorative gold quote marks background -->
  <div class="absolute top-12 left-8 text-[12rem] font-display text-gold/[0.04] leading-none select-none pointer-events-none" aria-hidden="true">&ldquo;</div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <SectionLabel label="Testimonials" />
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-warm-white mt-4">
        What our clients <span class="text-gold italic">say</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial, i) => (
        <div
          class="relative bg-black-mid border border-white/5 p-8 lg:p-10"
          data-animate
          style={`animation-delay: ${(i + 1) * 150}ms; opacity: 0;`}
        >
          <!-- Gold quote mark -->
          <span class="block font-display text-5xl text-gold/30 leading-none mb-4" aria-hidden="true">&ldquo;</span>
          <blockquote class="text-warm-white/70 text-sm font-body leading-relaxed mb-8">
            {testimonial.quote}
          </blockquote>
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/10 border border-gold/20 flex items-center justify-center">
              <span class="font-display text-gold text-sm">{testimonial.name.charAt(0)}</span>
            </div>
            <div>
              <p class="text-warm-white text-sm font-body font-medium">{testimonial.name}</p>
              <p class="text-gold-dim text-xs font-body">{testimonial.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
