---
import Layout from '../components/layout/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import GoldRule from '../components/ui/GoldRule.astro';

const team = [
  {
    name: 'Kwamah Lansana',
    title: 'Co-Owner & Principal Engineer',
    bio: 'Kwamah brings deep expertise in land surveying and property development, with a focus on precision-driven solutions for complex terrain. His leadership ensures every project meets the highest standards of accuracy.',
    expertise: ['Land Surveying', 'Property Development', 'GIS Mapping'],
    linkedin: '#',
  },
  {
    name: 'Mohamed Conteh',
    title: 'Lead Architectural Designer',
    bio: 'Mohamed combines creative vision with technical mastery, delivering architectural designs that are both aesthetically compelling and structurally sound. His work spans residential, commercial, and mixed-use projects.',
    expertise: ['Architectural Design', '3D Rendering', 'AutoCAD'],
    linkedin: '#',
  },
  {
    name: 'Aminata Kamara',
    title: 'Survey Technician',
    bio: 'Aminata specialises in drone-based surveying and photogrammetry, bringing cutting-edge technology to every site assessment. Her meticulous approach to data collection ensures reliable results.',
    expertise: ['Drone Operations', 'Photogrammetry', 'Topographic Surveys'],
    linkedin: '#',
  },
];
---

<Layout
  title="Our People"
  description="Meet the team behind Regal Engineering & Design Solutions. Experts in land surveying, architectural design, and integrated development in Sierra Leone."
>
  <!-- Hero -->
  <section class="relative pt-32 pb-16 bg-black">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-body text-grey mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="text-gold-dim">/</span>
        <span class="text-warm-white/60">Our People</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-warm-white mb-6">Our <span class="text-gold italic">People</span></h1>
      <p class="text-warm-white/60 font-body text-lg max-w-2xl leading-relaxed">
        The expertise behind every survey, every design, every project.
      </p>
    </div>
  </section>

  <GoldRule class="mx-auto" width="80%" />

  <!-- Team Grid -->
  <section class="py-16 lg:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map((member, i) => (
          <div
            class="group bg-black-soft border border-white/5 hover:border-gold/20 transition-all duration-500 overflow-hidden"
            data-animate
            style={`animation-delay: ${(i + 1) * 150}ms; opacity: 0;`}
          >
            <!-- Photo placeholder -->
            <div class="relative aspect-[3/4] bg-black-mid overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-gold/5 to-transparent"></div>
              {/* Silhouette placeholder */}
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="w-32 h-32 text-gold/10" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black-soft via-transparent to-transparent"></div>
            </div>

            <!-- Info -->
            <div class="p-6 lg:p-8">
              <h3 class="font-display text-xl text-warm-white mb-1">{member.name}</h3>
              <p class="text-gold text-sm font-body mb-4">{member.title}</p>
              <p class="text-warm-white/50 text-sm font-body leading-relaxed mb-6">{member.bio}</p>

              <!-- Expertise tags -->
              <div class="flex flex-wrap gap-2 mb-4">
                {member.expertise.map(tag => (
                  <span class="px-3 py-1 text-[10px] tracking-[0.15em] uppercase font-body border border-white/10 text-warm-white/40">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- LinkedIn -->
              {member.linkedin && (
                <a
                  href={member.linkedin}
                  aria-label={`${member.name} on LinkedIn`}
                  class="inline-flex items-center gap-2 text-grey hover:text-gold transition-colors duration-300"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership Note -->
  <section class="py-12 bg-black-soft border-t border-white/5">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-grey text-sm font-body">
        Regal Engineering & Design Solutions is a subsidiary of <strong class="text-warm-white/70">Regal Affluent Holding LLC</strong>.
      </p>
    </div>
  </section>
</Layout>
