---
import Layout from '../components/layout/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import GoldRule from '../components/ui/GoldRule.astro';

const values = [
  {
    title: 'Precision',
    description: 'Every measurement, every line, every plan is exact. We leave nothing to guesswork.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>`,
  },
  {
    title: 'Integrity',
    description: 'We deliver what we promise, transparently. Our reputation is built on trust.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
  },
  {
    title: 'Innovation',
    description: 'Drone technology, advanced CAD, cutting-edge GIS tools. We invest in the best to deliver the best.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`,
  },
  {
    title: 'Client-Centric',
    description: 'Your project vision guides our process. Every decision is made with your goals in mind.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>`,
  },
];

const techStack = [
  { name: 'Drone Equipment', desc: 'DJI Phantom & Mavic for aerial surveys' },
  { name: 'AutoCAD & Civil 3D', desc: 'Industry-standard design and drafting' },
  { name: 'Revit', desc: 'Building information modelling (BIM)' },
  { name: 'Pix4D', desc: 'Photogrammetry and 3D reconstruction' },
  { name: 'ArcGIS / QGIS', desc: 'Geographic information system mapping' },
];

const clients = [
  'Real estate buyers & sellers',
  'Property developers',
  'Homeowners building or renovating',
  'Government agencies & municipalities',
  'Construction firms',
];
---

<Layout
  title="About"
  description="Learn about Regal Engineering & Design Solutions — our mission, values, technology, and the team driving precision surveying and architectural design in Sierra Leone."
>
  <!-- Hero -->
  <section class="relative pt-32 pb-16 bg-black">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-body text-grey mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="text-gold-dim">/</span>
        <span class="text-warm-white/60">About</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-warm-white mb-6">About <span class="text-gold italic">Us</span></h1>
    </div>
  </section>

  <GoldRule class="mx-auto" width="80%" />

  <!-- Who We Are -->
  <section class="py-20 lg:py-28 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div data-animate>
          <SectionLabel label="Who We Are" number="01" />
          <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4 mb-6">
            Building Sierra Leone's future with <span class="text-gold italic">precision</span>
          </h2>
          <p class="text-warm-white/60 font-body leading-relaxed mb-4">
            Regal Engineering & Design Solutions is a land surveying and architectural design company based in Freetown, Sierra Leone. As a subsidiary of Regal Affluent Holding LLC, we bring together two essential disciplines under one roof.
          </p>
          <p class="text-warm-white/60 font-body leading-relaxed">
            Founded with a mission to streamline land acquisition and development, we serve real estate buyers, developers, homeowners, construction firms, and government agencies. Our integrated approach eliminates the coordination gaps that plague traditional multi-vendor projects.
          </p>
        </div>
        <div class="relative" data-animate style="animation-delay: 200ms; opacity: 0;">
          <div class="aspect-[4/3] bg-black-mid overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&q=80"
              alt="Engineering survey work in progress"
              class="w-full h-full object-cover opacity-70"
              loading="lazy"
            />
          </div>
          {/* Decorative corner */}
          <div class="absolute -bottom-4 -right-4 w-24 h-24 border border-gold/20"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="py-20 lg:py-28 bg-black-soft relative overflow-hidden">
    <div class="absolute top-0 left-[5%] text-[10rem] lg:text-[16rem] font-display text-gold/[0.03] leading-none select-none pointer-events-none" aria-hidden="true">&ldquo;</div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="relative" data-animate>
          <SectionLabel label="Our Mission" />
          <blockquote class="font-display text-2xl md:text-3xl text-warm-white leading-snug mt-4">
            <span class="text-gold">&ldquo;</span>To provide accurate land surveying and premium architectural design services that empower clients to make informed real estate and development decisions.<span class="text-gold">&rdquo;</span>
          </blockquote>
        </div>
        <div class="relative" data-animate style="animation-delay: 200ms; opacity: 0;">
          <SectionLabel label="Our Vision" />
          <blockquote class="font-display text-2xl md:text-3xl text-warm-white leading-snug mt-4">
            <span class="text-gold">&ldquo;</span>To become a leading provider of integrated land survey and architectural solutions, known for precision, reliability, and innovation.<span class="text-gold">&rdquo;</span>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values -->
  <section class="py-20 lg:py-28 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16" data-animate>
        <SectionLabel label="Our Values" number="02" />
        <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4">
          What drives <span class="text-gold italic">everything</span> we do
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((value, i) => (
          <div
            class="bg-black-soft border border-white/5 p-8 text-center hover:border-gold/20 transition-all duration-500"
            data-animate
            style={`animation-delay: ${(i + 1) * 120}ms; opacity: 0;`}
          >
            <div class="w-12 h-12 mx-auto mb-4 border border-gold/30 flex items-center justify-center text-gold">
              <Fragment set:html={value.icon} />
            </div>
            <h3 class="font-display text-lg text-gold mb-3">{value.title}</h3>
            <p class="text-warm-white/50 text-sm font-body leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Technology -->
  <section class="py-20 lg:py-28 bg-black-soft">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div data-animate>
        <SectionLabel label="Our Technology" number="03" />
        <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4 mb-4">
          Tools of <span class="text-gold italic">the trade</span>
        </h2>
        <p class="text-warm-white/50 font-body max-w-2xl mb-14">
          We invest in industry-leading technology to deliver results that exceed expectations.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {techStack.map((tech, i) => (
          <div
            class="bg-black-mid border border-white/5 p-6 hover:border-gold/20 transition-all duration-500"
            data-animate
            style={`animation-delay: ${(i + 1) * 100}ms; opacity: 0;`}
          >
            <h4 class="font-display text-sm text-gold mb-1">{tech.name}</h4>
            <p class="text-warm-white/40 text-xs font-body">{tech.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who We Serve -->
  <section class="py-20 lg:py-28 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div data-animate>
          <SectionLabel label="Our Clients" number="04" />
          <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4 mb-8">
            Who we <span class="text-gold italic">serve</span>
          </h2>
          <ul class="space-y-4">
            {clients.map((client, i) => (
              <li
                class="flex items-center gap-4 text-warm-white/70 font-body"
                data-animate
                style={`animation-delay: ${(i + 1) * 100}ms; opacity: 0;`}
              >
                <div class="w-2 h-2 bg-gold rotate-45 shrink-0"></div>
                {client}
              </li>
            ))}
          </ul>
        </div>
        <div class="relative" data-animate style="animation-delay: 200ms; opacity: 0;">
          <div class="aspect-[4/3] bg-black-mid overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&q=80"
              alt="Modern building architecture"
              class="w-full h-full object-cover opacity-60"
              loading="lazy"
            />
          </div>
          <div class="absolute -top-4 -left-4 w-24 h-24 border border-gold/20"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>
