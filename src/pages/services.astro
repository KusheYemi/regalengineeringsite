---
import Layout from '../components/layout/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import GoldRule from '../components/ui/GoldRule.astro';
import Button from '../components/ui/Button.astro';

const surveyingServices = [
  {
    name: 'Boundary Surveys',
    description: 'Defining legal property lines with precision using GPS and total station equipment. Essential for property transactions, disputes, and development planning.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" /></svg>`,
  },
  {
    name: 'Topographic Surveys',
    description: 'Mapping terrain elevation, natural features, and existing structures. Critical data for architects, engineers, and site planners before any development begins.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5a2.25 2.25 0 0 0 2.25-2.25V5.25A2.25 2.25 0 0 0 20.25 3H3.75a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 3.75 21Z" /></svg>`,
  },
  {
    name: 'Construction Staking',
    description: 'Marking exact positions for construction teams on the ground. We translate architectural plans into physical reference points so builders can work with confidence.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>`,
  },
  {
    name: 'Subdivision Planning',
    description: 'Dividing land into smaller parcels for development or sale. We handle lot layouts, access roads, and regulatory compliance for efficient land use.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" /></svg>`,
  },
  {
    name: 'Legal Land Descriptions',
    description: 'Official documentation of land boundaries for deeds, mortgages, and legal proceedings. Accurate, court-admissible survey reports you can rely on.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>`,
  },
];

const designServices = [
  {
    name: 'Conceptual Designs',
    description: 'Initial visual concepts to define your project\'s direction. We explore form, space, and function before committing to detailed plans.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>`,
  },
  {
    name: '3D Renderings',
    description: 'Photorealistic visualisations of your future structure. See your building come to life before a single brick is laid.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>`,
  },
  {
    name: 'Floor Plans & Site Plans',
    description: 'Detailed spatial layouts for builders and planners. Every room, every dimension, every relationship between spaces — documented with precision.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" /></svg>`,
  },
  {
    name: 'Structural Layouts',
    description: 'In partnership with engineering firms, we prepare structural layouts that ensure safety, compliance, and constructability.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>`,
  },
  {
    name: 'Permit Drawings',
    description: 'Compliant drawings ready for regulatory submission. We understand local building codes and ensure your plans meet all requirements for approval.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
  },
];
---

<Layout
  title="Services"
  description="Explore our land surveying, architectural design, and integrated development services. From boundary surveys to 3D renderings — Regal Engineering delivers."
>
  <!-- Page Hero -->
  <section class="relative pt-32 pb-16 bg-black">
    <div class="absolute inset-0 opacity-[0.02]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(90deg, var(--color-gold) 0, var(--color-gold) 1px, transparent 1px, transparent 60px);"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-body text-grey mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="text-gold-dim">/</span>
        <span class="text-warm-white/60">Services</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-warm-white mb-6">Our <span class="text-gold italic">Services</span></h1>
      <p class="text-warm-white/60 font-body text-lg max-w-2xl leading-relaxed">
        From the first boundary survey to your final architectural plan — we handle it all.
      </p>
    </div>
  </section>

  <GoldRule class="mx-auto" width="80%" />

  <!-- Land Surveying Services -->
  <section id="land-surveying" class="py-20 lg:py-28 bg-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div data-animate>
        <SectionLabel label="Service Category 01" />
        <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4 mb-4">Land Surveying <span class="text-gold italic">Services</span></h2>
        <p class="text-warm-white/50 font-body max-w-2xl mb-14">
          Our surveying team combines cutting-edge drone technology with traditional survey methods to deliver data you can build on — literally.
        </p>
      </div>

      <div class="space-y-6">
        {surveyingServices.map((service, i) => (
          <div
            class="group flex flex-col md:flex-row gap-6 md:gap-8 p-6 md:p-8 bg-black-soft border border-white/5 hover:border-gold/20 transition-all duration-500"
            data-animate
            style={`animation-delay: ${i * 100}ms; opacity: 0;`}
          >
            <div class="flex-shrink-0 w-12 h-12 border border-gold/30 flex items-center justify-center text-gold">
              <Fragment set:html={service.icon} />
            </div>
            <div>
              <h3 class="font-display text-xl text-warm-white mb-2 group-hover:text-gold transition-colors duration-300">{service.name}</h3>
              <p class="text-warm-white/50 font-body text-sm leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Architectural Design Services -->
  <section id="architectural-design" class="py-20 lg:py-28 bg-black-soft">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div data-animate>
        <SectionLabel label="Service Category 02" />
        <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4 mb-4">Architectural Design <span class="text-gold italic">Services</span></h2>
        <p class="text-warm-white/50 font-body max-w-2xl mb-14">
          From the first sketch to permit-ready documents, our design team transforms your vision into precise, buildable plans.
        </p>
      </div>

      <div class="space-y-6">
        {designServices.map((service, i) => (
          <div
            class="group flex flex-col md:flex-row gap-6 md:gap-8 p-6 md:p-8 bg-black-mid border border-white/5 hover:border-gold/20 transition-all duration-500"
            data-animate
            style={`animation-delay: ${i * 100}ms; opacity: 0;`}
          >
            <div class="flex-shrink-0 w-12 h-12 border border-gold/30 flex items-center justify-center text-gold">
              <Fragment set:html={service.icon} />
            </div>
            <div>
              <h3 class="font-display text-xl text-warm-white mb-2 group-hover:text-gold transition-colors duration-300">{service.name}</h3>
              <p class="text-warm-white/50 font-body text-sm leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Integrated Packages -->
  <section id="integrated" class="py-20 lg:py-28 bg-black relative overflow-hidden">
    <div class="absolute top-0 right-[10%] w-px h-full bg-gradient-to-b from-gold/0 via-gold/10 to-gold/0 hidden lg:block" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div data-animate>
        <SectionLabel label="Service Category 03" />
        <h2 class="font-display text-3xl md:text-4xl text-warm-white mt-4 mb-4">Integrated <span class="text-gold italic">Packages</span></h2>
        <p class="text-warm-white/50 font-body max-w-2xl mb-4">
          Our unique selling point: survey and design services bundled into one seamless engagement.
        </p>
        <p class="text-gold font-body text-sm italic mb-14">"One firm, two disciplines, zero coordination overhead."</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { title: 'Residential & Commercial Property Development', desc: 'Complete survey-to-design pipeline for new builds, renovations, and commercial projects.' },
          { title: 'Land Subdivision & Development Planning', desc: 'Strategic land division with integrated architectural site planning for maximum value.' },
          { title: 'Feasibility Studies', desc: 'Data-driven analysis combining survey data and design possibilities to inform investment decisions.' },
        ].map((item, i) => (
          <div
            class="bg-black-soft border border-gold/10 p-8 hover:border-gold/30 transition-all duration-500"
            data-animate
            style={`animation-delay: ${(i + 1) * 150}ms; opacity: 0;`}
          >
            <div class="text-gold font-display text-3xl mb-4 opacity-30">0{i + 1}</div>
            <h3 class="font-display text-lg text-warm-white mb-3">{item.title}</h3>
            <p class="text-warm-white/50 font-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-black-soft">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center" data-animate>
      <h2 class="font-display text-3xl md:text-4xl text-warm-white mb-4">Not sure which service you need?</h2>
      <p class="text-warm-white/50 font-body text-sm mb-8">Let's talk through your project requirements and find the right fit.</p>
      <Button href="/contact" variant="filled">Talk to Us</Button>
    </div>
  </section>
</Layout>
