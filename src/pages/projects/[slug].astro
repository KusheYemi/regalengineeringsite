---
import { getCollection } from 'astro:content';
import Layout from '../../components/layout/Layout.astro';
import GoldRule from '../../components/ui/GoldRule.astro';
import Button from '../../components/ui/Button.astro';

const categoryLabels: Record<string, string> = {
  'land-surveying': 'Land Surveying',
  'architectural-design': 'Architectural Design',
  'integrated': 'Integrated',
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
---

<Layout
  title={data.title}
  description={data.shortDescription}
  image={data.image}
>
  <!-- Hero Image -->
  <section class="relative pt-20">
    <div class="relative h-[50vh] lg:h-[60vh] overflow-hidden">
      <img
        src={data.image}
        alt={data.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
    </div>
  </section>

  <!-- Project Content -->
  <section class="relative bg-black -mt-32 pt-8">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs font-body text-grey mb-8 relative z-10">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span class="text-gold-dim">/</span>
        <a href="/projects" class="hover:text-gold transition-colors">Projects</a>
        <span class="text-gold-dim">/</span>
        <span class="text-warm-white/60">{data.title}</span>
      </div>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-4 mb-6 relative z-10">
        <span class="px-3 py-1 text-[10px] tracking-[0.2em] uppercase font-body border border-gold/50 text-gold">
          {categoryLabels[data.category]}
        </span>
        <span class="text-grey text-sm font-body">{data.location}</span>
        <span class="text-grey text-sm font-body">{data.year}</span>
      </div>

      <h1 class="font-display text-3xl md:text-4xl lg:text-5xl text-warm-white mb-8">{data.title}</h1>
      <p class="text-warm-white/70 font-body text-lg leading-relaxed mb-12">{data.shortDescription}</p>

      <GoldRule width="100%" class="mb-12" />

      <!-- Challenge / Approach / Outcome -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
        {[
          { label: 'The Challenge', content: data.challenge },
          { label: 'Our Approach', content: data.approach },
          { label: 'The Outcome', content: data.outcome },
        ].map((section, i) => (
          <div class="relative" data-animate style={`animation-delay: ${i * 150}ms; opacity: 0;`}>
            <span class="text-gold text-xs tracking-[0.2em] uppercase font-body block mb-3">{section.label}</span>
            <p class="text-warm-white/60 font-body text-sm leading-relaxed">{section.content}</p>
          </div>
        ))}
      </div>

      <!-- Services Used -->
      <div class="mb-16" data-animate>
        <span class="text-gold text-xs tracking-[0.2em] uppercase font-body block mb-4">Services Used</span>
        <div class="flex flex-wrap gap-2">
          {data.services.map((service: string) => (
            <span class="px-4 py-2 text-xs font-body text-warm-white/60 border border-white/10 bg-black-soft">
              {service}
            </span>
          ))}
        </div>
      </div>

      <!-- Back link -->
      <div class="pb-20">
        <Button href="/projects" variant="ghost">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" />
          </svg>
          Back to Projects
        </Button>
      </div>
    </div>
  </section>
</Layout>
